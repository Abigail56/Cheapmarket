# Copy to .env.local for development. NEXT_PUBLIC_* values are built into the
# browser code, so changing them needs a rebuild.

# Where browsers reach the API (the backend's PUBLIC address)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: where the Next.js server reaches the API (e.g. http://api:8000 inside Docker).
# Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Card payments go through this gateway: paystack | flutterwave
NEXT_PUBLIC_PAYMENT_PROVIDER=paystack
# Shown in the footer and on help messages
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
