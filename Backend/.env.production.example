# PRODUCTION template for docker-compose.prod.yml. On the server: cp .env.production.example .env
# and fill in every value marked REQUIRED. Never commit the real .env

# REQUIRED: the public domain whose DNS points at this server (Caddy gets HTTPS for it)
DOMAIN=api.cheapmarketdeals.com
PROJECT_NAME="Cheapmarketdeal API"
ENVIRONMENT=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED (the API refuses to start in production with a weak one)
SECRET_KEY=

POSTGRES_USER=cmd_user
# REQUIRED: a long random password
POSTGRES_PASSWORD=
POSTGRES_DB=cmd_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REQUIRED: a long random password (Redis refuses unauthenticated clients)
REDIS_PASSWORD=

# JSON list
# REQUIRED: your shop frontend address(es)
CORS_ORIGINS=["https://cheapmarketdeals.com"]

# Payments. REQUIRED for card payments: live keys from the Paystack / Flutterwave dashboards.
# Webhook URLs to set there: https://<DOMAIN>/api/v1/payments/webhook/paystack and .../flutterwave
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Business
CURRENCY=NGN
DEFAULT_PHONE_COUNTRY_CODE=+234
FRONTEND_URL=https://cheapmarketdeals.com
RATE_LIMIT_ENABLED=true
# Lock an email/phone after this many failed passwords, for this many seconds
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# First admin, created by `python -m scripts.seed`
ADMIN_EMAIL=admin@cheapmarketdeals.com
# REQUIRED: the seed script refuses the default password in production
ADMIN_PASSWORD=
ADMIN_NAME="Store Admin"

# Bank transfer details (optional)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Flutterwave webhook hash (optional)
FLUTTERWAVE_SECRET_HASH=


# --- Logging & error tracking -------------------------------------------------
LOG_LEVEL=INFO
# Default: JSON logs everywhere except ENVIRONMENT=local
# LOG_JSON=true
# From sentry.io > Project settings > Client keys. Empty = off
# Recommended
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- SMS & email (order updates, reset codes, phone verification) -------------
# "console" only writes messages to the worker log. Use real providers in production.
# SMS_BACKEND: console | termii
SMS_BACKEND=termii
TERMII_API_KEY=
# Sender ID must be approved in your Termii dashboard
TERMII_SENDER_ID=CheapMkt
# EMAIL_BACKEND: console | smtp
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Cheapmarketdeal <no-reply@cheapmarketdeals.com>"

# --- Image uploads -------------------------------------------------------------
# STORAGE_BACKEND: local | cloudinary
STORAGE_BACKEND=local
# Public URL where /media is reachable (local backend)
MEDIA_BASE_URL=https://api.cheapmarketdeals.com/media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backups (docker compose `backup` service) ----------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14

# --- Behind a reverse proxy: its IP/subnet, so rate limits see real client IPs ---
# Already set by docker-compose.prod.yml (only Caddy is trusted). Don't set it here.

# --- Deliveries / rider app -------------------------------------------------------
# Public address of this API: tracking links in SMS are PUBLIC_BASE_URL/track/<token>
PUBLIC_BASE_URL=https://api.cheapmarketdeals.com
# Seconds a rider has to accept an offer before it returns to the admin
RIDER_ACCEPT_SECONDS=300
# The rider must be this close (metres) to the confirmed pin to arrive / use the code
GEOFENCE_METERS=300
DELIVERY_CODE_TTL_SECONDS=600
DELIVERY_CODE_MAX_ATTEMPTS=5

# --- Web push for the rider app (alerts when the app is closed) --------------------
# Generate once per environment with:  python -m scripts.vapid_keys
# Keep them: changing them breaks every rider's existing alert subscription.
# Empty = push off (riders still get an SMS for each new offer).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cheapmarketdeals.com

# --- "Continue with Google" (optional) -------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID
# > Web application. Add every address the pages are opened from under "Authorized
# JavaScript origins" (e.g. https://yourdomain.com). No client secret is needed.
GOOGLE_CLIENT_ID=

# --- Checking rider IDs against government records (optional) ---------------------------
# none  = free checks only (number format, same ID used twice); admins check IDs by hand
# dojah = NIN looked up with NIMC + selfie face match, via dojah.io (paid per check).
#         Test with https://sandbox.dojah.io and sandbox keys; live is https://api.dojah.io
ID_VERIFY_PROVIDER=none
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io
ID_FACE_MATCH_THRESHOLD=90
ID_NAME_MATCH_THRESHOLD=80

